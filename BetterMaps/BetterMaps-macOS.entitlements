<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac Catalyst build. Same iCloud container as the iOS entitlements, so the
     Mac reads and writes the same CloudKit records as the iPhone. The Mac App
     Store (and so TestFlight) requires the sandbox; network.client is every
     fetch (CloudKit, maps, transit feeds), location is the blue dot. On macOS
     the push key is spelled com.apple.developer.aps-environment; CloudKit
     needs it to hear about changes made on the other devices. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <key>com.apple.developer.aps-environment</key>
    <string>development</string>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.gabrielconlon.CustomMapApp</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
</dict>
</plist>
